NEXT_PUBLIC_STORE_ADDRESS="Shop #2 Plot #C22 Gulistan-e-juhar Block 9 pakistan homes near pak ideal society. 75290"
NEXT_PUBLIC_STORE_PHONE="0313 8230045 / 0311 2983178 / 0346 2769171"
NEXT_PUBLIC_STORE_EMAIL="info@alamafhhihramhouse.com"
NEXT_PUBLIC_STORE_TAX_NUMBER="STRN-12345678-9"
