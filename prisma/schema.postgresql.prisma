// PostgreSQL Production Schema for Al-Afhhihram House POS
// Use this file when deploying to PostgreSQL cloud/on-premise database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum MovementType {
  STOCK_IN_PO
  STOCK_OUT_SALE
  STOCK_OUT_DAMAGE
  STOCK_OUT_RETURN
  MANUAL_ADJUSTMENT
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_WALLET
  SPLIT
  BANK_TRANSFER
}

enum TransactionStatus {
  COMPLETED
  REFUNDED
  VOID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum POStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  PACKAGING
  TRANSPORT
  SALARIES
  MARKETING
  MISC
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique @db.VarChar(50)
  email         String?   @unique @db.VarChar(120)
  passwordHash  String    @db.VarChar(255)
  fullName      String    @db.VarChar(100)
  role          Role      @default(CASHIER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  shifts        Shift[]
  sales         SalesTransaction[]
  expenses      Expense[]
  stockAudits   StockMovement[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  products    Product[]

  @@map("categories")
}

model Product {
  id                  String    @id @default(uuid())
  sku                 String    @unique @db.VarChar(50)
  barcode             String    @unique @db.VarChar(100)
  name                String    @db.VarChar(200)
  description         String?   @db.Text
  categoryId          String
  purchasePrice       Decimal   @db.Decimal(12, 2)
  sellingPrice        Decimal   @db.Decimal(12, 2)
  stockQuantity       Int       @default(0)
  minStockThreshold   Int       @default(5)
  unit                String    @default("pcs") @db.VarChar(20)
  size                String?   @db.VarChar(30)
  color               String?   @db.VarChar(30)
  brand               String?   @db.VarChar(100)
  imageUrl            String?   @db.Text
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  category            Category  @relation(fields: [categoryId], references: [id])
  stockMovements      StockMovement[]
  salesItems          SalesItem[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@index([barcode])
  @@index([sku])
  @@index([categoryId])
  @@map("products")
}

model StockMovement {
  id            String        @id @default(uuid())
  productId     String
  movementType  MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  referenceId   String?       @db.VarChar(100)
  referenceType String?       @db.VarChar(50)
  notes         String?       @db.Text
  performedById String
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)

  product       Product       @relation(fields: [productId], references: [id])
  performedBy   User          @relation(fields: [performedById], references: [id])

  @@index([productId])
  @@index([movementType])
  @@map("stock_movements")
}

model Supplier {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(150)
  companyName   String?   @db.VarChar(150)
  phone         String?   @db.VarChar(50)
  email         String?   @db.VarChar(100)
  address       String?   @db.Text
  currentBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  ledgerEntries  SupplierLedgerEntry[]

  @@map("suppliers")
}

model SupplierLedgerEntry {
  id              String    @id @default(uuid())
  supplierId      String
  referenceType   String    @db.VarChar(50)
  referenceId     String?   @db.VarChar(100)
  debit           Decimal   @default(0.00) @db.Decimal(12, 2)
  credit          Decimal   @default(0.00) @db.Decimal(12, 2)
  runningBalance  Decimal   @db.Decimal(12, 2)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  supplier        Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_ledger_entries")
}

model Shift {
  id                  String      @id @default(uuid())
  cashierId           String
  shiftNumber         Int?
  openedAt            DateTime    @default(now()) @db.Timestamptz(6)
  closedAt            DateTime?   @db.Timestamptz(6)
  openingCash         Decimal     @default(0.00) @db.Decimal(12, 2)
  closingCash         Decimal?    @db.Decimal(12, 2)
  systemExpectedCash  Decimal?    @db.Decimal(12, 2)
  cashDifference      Decimal?    @db.Decimal(12, 2)
  totalSalesAmount    Decimal     @default(0.00) @db.Decimal(12, 2)
  totalTransactions   Int         @default(0)
  status              ShiftStatus @default(OPEN)
  notes               String?     @db.Text

  cashier             User        @relation(fields: [cashierId], references: [id])
  sales               SalesTransaction[]

  @@index([cashierId])
  @@index([status])
  @@map("shifts")
}

model SalesTransaction {
  id                  String            @id @default(uuid())
  invoiceNumber       String            @unique @db.VarChar(50)
  clientTransactionId String?           @unique @db.VarChar(100)
  cashierId           String
  shiftId             String?
  customerName        String?           @default("Walk-in Customer") @db.VarChar(100)
  customerPhone       String?           @db.VarChar(30)
  subtotal            Decimal           @db.Decimal(12, 2)
  discountType        String?           @db.VarChar(20)
  discountValue       Decimal           @default(0.00) @db.Decimal(12, 2)
  discountAmount      Decimal           @default(0.00) @db.Decimal(12, 2)
  taxRate             Decimal           @default(0.15) @db.Decimal(5, 4)
  taxAmount           Decimal           @default(0.00) @db.Decimal(12, 2)
  totalAmount         Decimal           @db.Decimal(12, 2)
  paymentMethod       PaymentMethod     @default(CASH)
  amountTendered      Decimal           @default(0.00) @db.Decimal(12, 2)
  changeDue           Decimal           @default(0.00) @db.Decimal(12, 2)
  status              TransactionStatus @default(COMPLETED)
  isSynced            Boolean           @default(true)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  cashier             User              @relation(fields: [cashierId], references: [id])
  shift               Shift?            @relation(fields: [shiftId], references: [id])
  items               SalesItem[]

  @@index([invoiceNumber])
  @@index([cashierId])
  @@index([createdAt])
  @@map("sales_transactions")
}

model SalesItem {
  id              String            @id @default(uuid())
  transactionId   String
  productId       String
  productName     String            @db.VarChar(200)
  sku             String            @db.VarChar(50)
  unitPrice       Decimal           @db.Decimal(12, 2)
  costPrice       Decimal           @db.Decimal(12, 2)
  quantity        Int
  discountAmount  Decimal           @default(0.00) @db.Decimal(12, 2)
  subtotalAmount  Decimal           @db.Decimal(12, 2)

  transaction     SalesTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
  @@map("sales_items")
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique @db.VarChar(50)
  supplierId    String
  orderDate     DateTime            @default(now()) @db.Timestamptz(6)
  expectedDate  DateTime?           @db.Timestamptz(6)
  receivedDate  DateTime?           @db.Timestamptz(6)
  totalAmount   Decimal             @default(0.00) @db.Decimal(12, 2)
  paidAmount    Decimal             @default(0.00) @db.Decimal(12, 2)
  status        POStatus            @default(ORDERED)
  notes         String?             @db.Text
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]

  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantityOrdered Int
  quantityReceived Int          @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model Expense {
  id            String          @id @default(uuid())
  expenseNumber String          @unique @db.VarChar(50)
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod   @default(CASH)
  date          DateTime        @default(now()) @db.Timestamptz(6)
  description   String          @db.Text
  recordedById  String
  receiptUrl    String?         @db.Text
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  recordedBy    User            @relation(fields: [recordedById], references: [id])

  @@index([category])
  @@index([date])
  @@map("expenses")
}
