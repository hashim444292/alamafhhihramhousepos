# ==============================================================================
# AL-AFHHIHRAM HOUSE POS & INVENTORY SYSTEM - PAKISTAN CONFIGURATION
# ==============================================================================

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Al-Afhhihram House POS"
NEXT_PUBLIC_STORE_NAME="Al-Afhhihram House"
NEXT_PUBLIC_STORE_TAGLINE="Premium Ihram Sets, Islamic Clothing & Hajj Accessories"
NEXT_PUBLIC_STORE_ADDRESS="Shop #12, Madinah Market, Urdu Bazar, Lahore / Karachi, Pakistan"
NEXT_PUBLIC_STORE_PHONE="+92 300 1234567"
NEXT_PUBLIC_STORE_TAX_NUMBER="STRN-12345678-9"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_CURRENCY_CODE="PKR"
NEXT_PUBLIC_DEFAULT_TAX_RATE=0.00 # 0% default (configurable for retail sales tax)

DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

JWT_SECRET="al-afhhihram-secret-jwt-key-2026-production-ready"
JWT_EXPIRES_IN="12h"
REFRESH_TOKEN_EXPIRES_IN="7d"

NEXT_PUBLIC_OFFLINE_CAPABLE=true
NEXT_PUBLIC_ENABLE_LOCAL_STORAGE_QUEUE=true
SYNC_BATCH_SIZE=50
SYNC_AUTH_HEADER_SECRET="terminal-node-sync-key-2026"

NEXT_PUBLIC_DEFAULT_RECEIPT_WIDTH="80mm"
NEXT_PUBLIC_ENABLE_AUTO_PRINT=false
NEXT_PUBLIC_BARCODE_PREFIX="AFH"
